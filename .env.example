# Example environment variables for development

# Postgres connection (host inside docker network)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/calorietracker

# JWT
SECRET_KEY=replace-with-a-secure-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# USDA FoodData Central — get a free key at https://fdc.nal.usda.gov/api-guide.html
USDA_API_KEY=DEMO_KEY

# OpenAI — required for the AI nutrition agent
# Get your key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
